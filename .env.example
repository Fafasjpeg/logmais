# copie este arquivo para .env e preencha os valores
# o arquivo .env nao vai pro github

# chave que protege a sessao e os cookies do flask
# gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria

# conexao com o mysql  formato usuario:senha@servidor:porta/banco
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/logmais

# chave da api da openai usada pelo chat do log
OPENAI_API_KEY=

# modelo da openai usado pelo chat do log
OPENAI_MODEL=gpt-4o-mini

# modelo menor e mais barato usado so nas dicas das perguntas
# use um modelo sem raciocinio escondido como gpt-4.1-nano
OPENAI_MODEL_DICAS=gpt-4.1-nano

# chave da api da brevo usada para enviar o codigo de verificacao por e-mail
# sem chave o codigo aparece so no terminal do flask
BREVO_API_KEY=

# e-mail que aparece como remetente dos codigos precisa estar verificado na brevo
# nao e mostrado em nenhuma tela do app
EMAIL_REMETENTE=

# 1 liga o modo debug e recarrega o app sozinho quando voce salva um arquivo
# deixe 0 ou apagado em qualquer lugar que outras pessoas possam acessar
FLASK_DEBUG=0

# 1 so quando o app estiver em https pro cookie da sessao nunca viajar sem criptografia
COOKIE_SEGURO=0
